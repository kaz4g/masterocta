        "patterns_using_part_follows_the_reference_not_nesting",
        "unmodeled_dependencies_are_explicit",
        "project_bank_selection_reuses_bank_index",
        "project_pattern_selection_reuses_pattern_index",
        "project_bank_selection_keeps_out_of_range_raw",
        "project_pattern_selection_keeps_out_of_range_raw",
        "arrangement_raw_stays_unmapped_for_every_stored_value",
        "playback_scale_keeps_unrecognized_raw",
        "per_track_master_length_keeps_inf_distinct_from_finite",
        "per_track_master_length_rejects_undocumented_multiplier"

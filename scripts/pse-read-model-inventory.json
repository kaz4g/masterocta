{
  "schema": "masterocta-pse-read-model-inventory:v1",
  "update_hint": "Add new required tests here when extending the Project Structure reader or domain. The CI runner fails closed on missing, ignored, failed, or zero executed tests.",
  "suites": [
    {
      "id": "ot-domain-project-structure",
      "package": "ot-domain",
      "features": [],
      "filter": "project_structure::",
      "required_tests": [
        "indices_reject_values_past_their_range",
        "index_iterators_cover_the_full_range",
        "bank_index_maps_to_letter_and_file_number",
        "machine_kind_keeps_unknown_raw_value",
        "patterns_using_part_follows_the_reference_not_nesting",
        "unmodeled_dependencies_are_explicit"
      ]
    },
    {
      "id": "masterocta-project-structure-reader",
      "package": "masterocta",
      "features": ["test-seams"],
      "filter": "project_structure_reader::",
      "required_tests": [
        "working_and_saved_bank_documents_stay_separate_entries",
        "working_only_bank_does_not_invent_a_saved_checkpoint",
        "saved_only_bank_is_not_promoted_to_working",
        "pattern_part_assignment_matches_the_legacy_reader",
        "multipart_fixture_uses_more_than_one_part",
        "multipart_pattern_part_cycle_matches_tracked_fixture",
        "real_device_patterns_all_use_part_zero",
        "track_slots_match_catalog_machine_usage_edges",
        "undecodable_bank_is_malformed_without_partial_structure",
        "bank_failing_validation_is_malformed_without_partial_structure",
        "reading_structure_leaves_every_file_byte_identical",
        "repeated_reads_return_equal_structure",
        "project_path_escaping_the_root_is_rejected",
        "missing_project_rejection_leaves_fixture_bytes_unchanged",
        "unreadable_bank_file_is_a_storage_error",
        "directory_named_as_bank_file_is_absent",
        "symlinked_bank_is_treated_as_absent",
        "machine_slot_raw_values_map_without_guessing"
      ]
    },
    {
      "id": "masterocta-bank-validation",
      "package": "masterocta",
      "features": ["test-seams"],
      "filter": "bank_validation::",
      "required_tests": [
        "tracked_real_device_bank_passes_header_and_version_validation",
        "header_mismatch_is_rejected",
        "flex_recorder_range_is_observable_but_not_regular_usage",
        "bank_machine_slot_zero_maps_to_first_pool_index",
        "bank_machine_slot_out_of_range_is_rejected",
        "known_machine_types_zero_through_four_pass_validation",
        "unknown_machine_type_rejects_bank",
        "unknown_machine_type_in_saved_part_rejects_bank"
      ]
    }
  ]
}
